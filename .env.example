# Copy to .env and replace placeholders when you have real values.
# Anything still starting with REPLACE_ME (or sk-REPLACE_ME, tvly-REPLACE_ME, ...) is treated as "not configured":
# the app then falls back to the scripted MockLLM / keyless DuckDuckGo search / no tracing, and still runs end-to-end.

APP_ENV=local
LOG_LEVEL=INFO

# --- Database (docker compose builds DATABASE_URL from these) ------------------------------
POSTGRES_USER=policy
POSTGRES_PASSWORD=REPLACE_ME_db_password
POSTGRES_DB=policy

# --- LLM providers ------------------------------------------------------------------------
# LLM_MODE: auto | mock | live      LLM_PROVIDER_ORDER: fallback order
LLM_MODE=auto
LLM_PROVIDER_ORDER=openai,gemini
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL_STRONG=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
GOOGLE_API_KEY=REPLACE_ME
GEMINI_MODEL_STRONG=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash
RUN_LLM_BUDGET_USD=0.50

# --- Langfuse (Cloud Hobby tier) ------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0

# --- Web search -----------------------------------------------------------------------------
# WEB_SEARCH_PROVIDER: auto | tavily | ddg | mock
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=tvly-REPLACE_ME
WEB_MAX_SEARCHES_PER_RUN=5
WEB_MAX_FETCHES_PER_RUN=8

# --- Data sources ---------------------------------------------------------------------------
SINGSTAT_MCP_URL=https://chatwithsandra.singstat.gov.sg/mcp
# Optional: higher Data.gov.sg rate limits
DATAGOV_API_KEY=REPLACE_ME
# true = serve every source from recorded snapshots
OFFLINE_MODE=false

# --- Security -------------------------------------------------------------------------------
# Set a real value in any public deployment (required on /api and /ws when set)
APP_ACCESS_TOKEN=REPLACE_ME
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Chaos toggles for the demo (also switchable at runtime: PUT /api/v1/admin/chaos) ---------
# e.g. CHAOS_FAIL_SOURCES=singstat_mcp,datagov   CHAOS_FAIL_LLM=openai
CHAOS_FAIL_SOURCES=
CHAOS_FAIL_LLM=
CHAOS_INJECT_HALLUCINATION=false
